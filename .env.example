# ==============================================================================
# PingKu Configuration Environment Variables (.env.example)
# ==============================================================================
# Salin file ini menjadi .env jika ingin mengubah konfigurasi bawaan:
# cp .env.example .env (Linux/macOS) atau Copy-Item .env.example .env (Windows)

# Port untuk Backend Server Express & WebSocket (Default: 8080)
PORT=8080

# Bind host (Default: 0.0.0.0 agar dapat diakses dari LAN/jaringan luar)
HOST=0.0.0.0

# DNS Resolver upstream default untuk fitur DNS Query Tool (Default: 1.1.1.1)
DEFAULT_RESOLVER=1.1.1.1

# Interval broadcast telemetri WebSocket dalam milidetik (Default: 2000 ms)
POLL_INTERVAL_MS=2000

# Mode Lingkungan (development / production)
NODE_ENV=production
